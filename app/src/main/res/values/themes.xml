<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AtlasMediaWidget" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/atlas_background</item>
        <item name="android:navigationBarColor">@color/atlas_background</item>
        <item name="android:windowBackground">@color/atlas_background</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
    </style>
    <style name="Theme.AtlasMediaWidget.WidgetControl" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.AtlasMediaWidget.Setup" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
 <FrameLayout android:id="@+id/widget_progress_box" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
 </FrameLayout>
 <FrameLayout android:id="@+id/widget_targets" android:layout_width="match_parent" android:layout_height="match_parent" />
 <FrameLayout android:id="@+id/widget_favorites_box" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
